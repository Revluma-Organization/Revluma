generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_alert_preferences {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ai_preference_id String         @db.Uuid
  alert_type       String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  ai_preferences   ai_preferences @relation(fields: [ai_preference_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ai_preference_id], map: "idx_ai_alerts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_monitoring_areas {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ai_preference_id String         @db.Uuid
  area_name        String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  ai_preferences   ai_preferences @relation(fields: [ai_preference_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ai_preference_id], map: "idx_ai_monitoring")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_preferences {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String                 @unique @db.Uuid
  insight_frequency    String
  alert_recipient      String
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  ai_alert_preferences ai_alert_preferences[]
  ai_monitoring_areas  ai_monitoring_areas[]
  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model onboarding_objectives {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onboarding_profile_id String              @db.Uuid
  objective             String
  created_at            DateTime?           @default(now()) @db.Timestamptz(6)
  onboarding_profiles   onboarding_profiles @relation(fields: [onboarding_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([onboarding_profile_id], map: "idx_objectives_profile")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model onboarding_profiles {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                  @unique @db.Uuid
  biggest_challenge     String?
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  onboarding_objectives onboarding_objectives[]
  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  onboarding_tools      onboarding_tools[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model onboarding_tools {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onboarding_profile_id String              @db.Uuid
  tool_category         String
  tool_name             String
  is_custom             Boolean?            @default(false)
  created_at            DateTime?           @default(now()) @db.Timestamptz(6)
  onboarding_profiles   onboarding_profiles @relation(fields: [onboarding_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([onboarding_profile_id], map: "idx_tools_profile")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model organizations {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id              String                 @db.Uuid
  company_name          String
  website_url           String?
  store_url             String?
  industry              String
  custom_industry       String?
  country               String
  state_region          String?
  team_size             String?
  monthly_revenue_range String?
  monthly_order_volume  String?
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?              @default(now()) @db.Timestamptz(6)
  ai_preferences        ai_preferences?
  users                 users                  @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stores                stores[]
  members               organization_members[]

  @@index([owner_id], map: "idx_organizations_owner")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name               String
  email                   String                 @unique
  password_hash           String
  two_factor_enabled      Boolean                @default(false)
  two_factor_secret       String?
  email_verified          Boolean?               @default(false)
  verification_code       String?
  verification_expires_at DateTime?              @db.Timestamptz(6)
  accepted_terms          Boolean                @default(false)
  accepted_privacy_policy Boolean                @default(false)
  onboarding_completed    Boolean?               @default(false)
  onboarding_step         Int?                   @default(1)
  status                  String?                @default("active")
  created_at              DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?              @default(now()) @db.Timestamptz(6)
  notifications           notifications[]
  refresh_tokens          refresh_tokens[]
  onboarding_profiles     onboarding_profiles?
  organizations           organizations[]
  preferences             UserPreference?
  organization_members    organization_members[]

  @@index([email], map: "idx_users_email")
}

model UserPreference {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  theme String @default("system")

  language String @default("en-GB")

  timezone String @default("Africa/Lagos")

  dateFormat String @default("DD/MM/YYYY") @map("date_format")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}


/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model waitlist_users {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                  String
  work_email                 String    @unique
  phone_number               String?
  twitter_handle             String?
  tiktok_handle              String?
  instagram_handle           String?
  company_name               String
  website_url                String?
  store_url                  String?
  industry                   String
  country                    String
  state_region               String?
  team_size                  String?
  monthly_revenue_range      String?
  monthly_order_volume       String?
  ecommerce_platform         String?
  email_platform             String?
  analytics_platform         String?
  support_platform           String?
  ad_platform                String?
  primary_goal               String?
  biggest_challenge          String
  current_churn_problem      Boolean?  @default(false)
  abandoned_cart_problem     Boolean?  @default(false)
  retention_problem          Boolean?  @default(false)
  revenue_visibility_problem Boolean?  @default(false)
  why_join_waitlist          String?
  interested_in_beta         Boolean?  @default(true)
  waitlist_position          Int?
  lead_score                 Int?      @default(0)
  status                     String?   @default("pending")
  welcome_email_sent         Boolean?  @default(false)
  ip_address                 String?
  user_agent                 String?
  created_at                 DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime? @default(now()) @db.Timestamptz(6)
  referral_code              String    @unique
  referred_by_code           String?
  referral_count             Int       @default(0)
  is_founding_member         Boolean   @default(false)

  @@index([country], map: "idx_waitlist_country")
  @@index([work_email], map: "idx_waitlist_email")
  @@index([industry], map: "idx_waitlist_industry")
  @@index([lead_score], map: "idx_waitlist_lead_score")
  @@index([waitlist_position], map: "idx_waitlist_position")
  @@index([status], map: "idx_waitlist_status")
  @@index([referral_code])
}

/// Connected Shopify or WooCommerce store for a merchant organization.
/// One organization can have multiple stores across platforms.
model stores {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String                @db.Uuid
  platform          String
  shop_domain       String
  access_token      String?
  status            String                @default("not_connected")
  installed_at      DateTime?             @db.Timestamptz(6)
  last_synced_at    DateTime?             @db.Timestamptz(6)
  created_at        DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?             @default(now()) @db.Timestamptz(6)
  abandoned_carts   abandoned_carts[]
  customers         customers[]
  events            events[]
  orders            orders[]
  sequences         sequences[]
  organizations     organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mlSessionFeatures ml_session_features[]

  @@unique([organization_id, shop_domain], map: "uq_stores_org_domain")
}

/// Shopper profile synced from Shopify or WooCommerce.
/// Stores consent flags for email/SMS marketing (legal compliance).
/// RFM fields are written by the Python rfm_sync job.
model customers {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id           String                @db.Uuid
  external_id        String
  email              String
  full_name          String?
  phone              String?
  anonymous_id       String?
  consent_email      Boolean?              @default(false)
  consent_sms        Boolean?              @default(false)
  consent_updated_at DateTime?             @db.Timestamptz(6)
  ltv                Decimal?              @default(0) @db.Decimal(10, 2)
  orders_count       Int?                  @default(0)
  rfm_recency        Int?
  rfm_frequency      Int?
  rfm_monetary       Int?
  rfm_segment        String?
  status             String?               @default("active")
  created_at         DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?             @default(now()) @db.Timestamptz(6)
  abandoned_carts    abandoned_carts[]
  stores             stores                @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events             events[]
  orders             orders[]
  mlSessionFeatures  ml_session_features[]

  @@unique([store_id, external_id], map: "uq_customers_store_external")
  @@index([store_id], map: "idx_customers_store")
  @@index([email], map: "idx_customers_email")
  @@index([rfm_segment], map: "idx_customers_rfm_segment")
  @@index([status], map: "idx_customers_status")
  @@index([anonymous_id], map: "idx_customers_anonymous")
  @@index([consent_email], map: "idx_customers_consent_email")
}

/// An abandoned checkout / cart detected on a merchant's store.
/// customer_id is nullable to support anonymous cart abandonment.
model abandoned_carts {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id             String                 @db.Uuid
  customer_id          String?                @db.Uuid
  external_cart_id     String?
  session_id           String?
  cart_value           Decimal                @db.Decimal(10, 2)
  currency             String?                @default("USD")
  status               String?                @default("abandoned")
  abandoned_at         DateTime               @db.Timestamptz(6)
  recovered_at         DateTime?              @db.Timestamptz(6)
  recovery_sequence_id String?                @db.Uuid
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  items                abandoned_cart_items[]
  customers            customers?             @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  sequences            sequences?             @relation(fields: [recovery_sequence_id], references: [id], onUpdate: NoAction)
  stores               stores                 @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders               orders[]
}

/// Individual line items within an abandoned cart.
/// Used to compute top abandoned products and power per-product recovery messaging.
model abandoned_cart_items {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  abandoned_cart_id   String          @db.Uuid
  external_product_id String
  external_variant_id String?
  product_name        String
  variant_name        String?
  price               Decimal         @db.Decimal(10, 2)
  quantity            Int
  image_url           String?
  product_url         String?
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  abandoned_carts     abandoned_carts @relation(fields: [abandoned_cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([abandoned_cart_id], map: "idx_cart_items_cart")
  @@index([external_product_id], map: "idx_cart_items_product")
}

/// Completed purchase — either organic or recovered via a sequence.
/// attribution_channel and abandoned_cart_id track recovery attribution.
/// coupon_used and coupon_code are required by ML pipeline (sensitivity model).
model orders {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id                String           @db.Uuid
  customer_id             String           @db.Uuid
  external_order_id       String
  total                   Decimal          @db.Decimal(10, 2)
  subtotal                Decimal?         @db.Decimal(10, 2)
  discount_amount         Decimal?         @db.Decimal(10, 2)
  currency                String?          @default("USD")
  coupon_used             Boolean?         @default(false)
  coupon_code             String?
  recovery_status         String?
  attribution_channel     String?
  attribution_sequence_id String?          @db.Uuid
  abandoned_cart_id       String?          @db.Uuid
  ordered_at              DateTime         @db.Timestamptz(6)
  created_at              DateTime?        @default(now()) @db.Timestamptz(6)
  abandoned_carts         abandoned_carts? @relation(fields: [abandoned_cart_id], references: [id], onUpdate: NoAction)
  sequences               sequences?       @relation(fields: [attribution_sequence_id], references: [id], onUpdate: NoAction)
  customers               customers        @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  stores                  stores           @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([store_id, external_order_id], map: "uq_orders_store_external")
}

/// Recovery message sequence configuration.
/// One sequence = one channel (email, SMS, WhatsApp, push).
/// sequence_sends and sequence_events are added in Phase 2 when recovery engine is built.
model sequences {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id        String            @db.Uuid
  name            String
  channel         String
  status          String?           @default("active")
  delay_mins      Int?              @default(30)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  abandoned_carts abandoned_carts[]
  orders          orders[]
  stores          stores            @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// In-app notification record for a merchant user.
/// read_at NULL = unread. Topbar badge counts rows WHERE read_at IS NULL.
model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  type       String
  message    String
  action_url String?
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Raw event stream — every pixel event from shopper sessions.
/// Source for Live Activity feed, ML feature pipeline, and identity resolution.
/// event_type values defined in docs/PIXEL_EVENT_SPEC.md.
model events {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id     String     @db.Uuid
  customer_id  String?    @db.Uuid
  session_id   String?
  anonymous_id String?
  event_type   String
  payload      Json?
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  customers    customers? @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  stores       stores     @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ml_session_features {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id     String  @db.Uuid
  customer_id  String? @db.Uuid
  session_id   String?
  anonymous_id String?

  // Behavioural Features
  scroll_depth_pct          Float?
  tab_switch_count          Int?
  time_on_checkout_step_sec Float?
  cursor_hesitation         Float?
  checkout_step_reached     Int?

  // Transactional Features
  past_orders_total           Int?
  past_orders_with_coupon_pct Float?
  days_since_last_purchase    Int?
  avg_order_value             Decimal? @db.Decimal(10, 2)
  purchase_frequency_trend    Float?
  visited_coupon_page         Boolean?
  searched_discount_terms     Boolean?

  // Temporal / Contextual Features
  abandoned_at_shipping_reveal Boolean?
  failed_payment_attempt       Boolean?
  local_hour_of_session        Int?
  day_of_week_session          Int?
  time_on_page_ms              Int?

  // Extended M2 Sensitivity Signals
  google_shopping_referrer        Boolean?
  time_first_view_to_cart_add_hrs Float?
  sale_period_purchase_only       Boolean?
  failed_coupon_attempt           Boolean?
  merchant_avg_order_value        Decimal? @db.Decimal(10, 2)
  account_creation_abandonment    Boolean?
  repeat_checkout_attempts        Int?
  device_type_mobile              Boolean?
  shipping_eta_dwell_sec          Float?
  trust_page_visited              Boolean?

  // New Smart Features
  failed_coupon_count                 Int?
  copied_product_title                Boolean?
  cart_value_vs_avg_order_value_ratio Float?

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  stores    stores     @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers customers? @relation(fields: [customer_id], references: [id], onUpdate: NoAction)

  @@index([store_id], map: "idx_ml_features_store")
  @@index([customer_id], map: "idx_ml_features_customer")
  @@index([session_id], map: "idx_ml_features_session")
  @@index([anonymous_id], map: "idx_ml_features_anonymous")
}

/// Persisted refresh tokens — enables real logout and token rotation.
/// On every refresh: old token is deleted, new one is created.
/// On logout: all tokens for the session (or all sessions) are deleted.
model refresh_tokens {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique // SHA-256 hash of the raw token — never store raw
  family_id    String    @db.Uuid // Groups a chain of rotated tokens — reuse = theft
  device_hint  String? // Browser/device info for display in "active sessions"
  ip_address   String?
  expires_at   DateTime  @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  is_revoked   Boolean   @default(false)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user")
  @@index([token_hash], map: "idx_refresh_tokens_hash")
  @@index([family_id], map: "idx_refresh_tokens_family")
  @@index([expires_at], map: "idx_refresh_tokens_expires")
}

/// Tracks failed login attempts per email for account lockout.
model login_attempts {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  ip_address   String?
  attempted_at DateTime? @default(now()) @db.Timestamptz(6)
  success      Boolean   @default(false)

  @@index([email], map: "idx_login_attempts_email")
  @@index([attempted_at], map: "idx_login_attempts_time")
}

/// RBAC: maps users to organizations with a role and status.
/// Owner is auto-created on registration; members/admins are invited.
model organization_members {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  role            String    @default("member") // owner | admin | member
  status          String    @default("active") // pending | active | removed
  invited_by      String?   @db.Uuid
  invited_at      DateTime? @db.Timestamptz(6)
  joined_at       DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, user_id], map: "uq_org_member")
  @@index([organization_id], map: "idx_org_members_org")
  @@index([user_id], map: "idx_org_members_user")
  @@index([status], map: "idx_org_members_status")
}

/// Single-use invite tokens — signed, expiring, bound to org + email + role.
model invite_tokens {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  email           String
  role            String    @default("member")
  invited_by      String    @db.Uuid
  token_hash      String    @unique
  expires_at      DateTime  @db.Timestamptz(6)
  accepted_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([organization_id], map: "idx_invite_tokens_org")
  @@index([email], map: "idx_invite_tokens_email")
  @@index([token_hash], map: "idx_invite_tokens_hash")
}

/// Per-admin API keys — hashed at rest, individually revocable, with audit trail.
/// Replaces the single static ADMIN_API_KEY env var for production use.
model admin_api_keys {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String // human-readable label (e.g. "CI deploy key")
  key_hash     String    @unique // SHA-256 hash of the raw key
  prefix       String // first 8 chars of raw key — shown in UI for identification
  scopes       String[]  @default(["read", "write"]) // permission scopes
  last_used_at DateTime? @db.Timestamptz(6)
  last_used_ip String?
  expires_at   DateTime? @db.Timestamptz(6) // null = never expires
  revoked_at   DateTime? @db.Timestamptz(6)
  created_by   String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([key_hash], map: "idx_admin_api_keys_hash")
  @@index([created_by], map: "idx_admin_api_keys_creator")
}

{
  "installCommand": "cd Frontend/Dashboard && npm install --include=dev",
  "buildCommand": "cd Frontend/Dashboard && npm run build -- --outDir ../dashboard --emptyOutDir",
  "outputDirectory": "Frontend",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/dashboard/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private"
        }
      ]
    },
    {
      "source": "/assets/videos/(.*)\\.mp4",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/videos/(.*)\\.MOV",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/quicktime"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/forgot-password",
      "destination": "/dashboard/index"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/dashboard/index"
    },
    {
      "source": "/login",
      "destination": "/auth/login.html"
    },
    {
      "source": "/login",
      "destination": "/auth/login.html"
    },
    {
      "source": "/auth/login",
      "destination": "/auth/login.html"
    },
    {
      "source": "/auth/signup",
      "destination": "/auth/signup.html"
    },
    {
      "source": "/auth/signUp",
      "destination": "/auth/signup.html"
    }
  ]
}

# PostgreSQL (shared with Node backend)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
SQL_ECHO=false

# Internal API key — must match ML_INTERNAL_KEY on the Node backend.
# The ML serving API rejects any request without this header.
ML_INTERNAL_KEY=change-me-to-a-random-64-char-hex-string

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# MLflow local server (optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# DagsHub-hosted MLflow (optional alternative to the local URI above).
# Never commit real credentials; set these values only in the untracked .env.
# MLFLOW_TRACKING_URI=https://dagshub.com/organization/repository.mlflow
# MLFLOW_TRACKING_USERNAME=your-dagshub-username
# MLFLOW_TRACKING_PASSWORD=your-dagshub-token

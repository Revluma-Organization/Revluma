# PostgreSQL (shared with Node backend)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
SQL_ECHO=false

# Internal API key — must match ML_INTERNAL_KEY on the Node backend.
# The ML serving API rejects any request without this header.
ML_INTERNAL_KEY=change-me-to-a-random-64-char-hex-string

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# MLflow local server (optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# DagsHub-hosted MLflow (optional alternative to the local URI above).
# Never commit real credentials; set these values only in the untracked .env.
# MLFLOW_TRACKING_URI=https://dagshub.com/organization/repository.mlflow
# MLFLOW_TRACKING_USERNAME=your-dagshub-username
# MLFLOW_TRACKING_PASSWORD=your-dagshub-token

# Beta prefers canary models and falls back to Production. Omit this variable
# for the controlled-beta default; set it to production only on a validated
# production deployment.
MODEL_RELEASE_CHANNEL=beta

# Optional lifecycle controls. Defaults are enabled with a seven-day canary.
MODEL_AUTO_PROMOTION_ENABLED=true
MODEL_CANARY_MIN_HOURS=168

# ── Rev agent runtime (src/agents/rev_agent.py, agent_gateway.py) ───────────
# Primary provider for the native tool-calling agent: anthropic | gemini.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gemini models (defaults shown). gemini-2.5-flash is deprecated by Google;
# do not configure it. The deep role runs the agent and composes answers; the
# fast role routes. An unset fallback defaults to the other role's model.
# 4xx responses (including 404 unknown model) are permanent and never retried.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
# Gemini 3.x/4 thinking levels: minimal | low | medium | high. minimal is
# raised to low on models that do not support it (3.8 Flash, Pro, Gemini 4).
GEMINI_FAST_THINKING_LEVEL=minimal
GEMINI_DEEP_THINKING_LEVEL=low
# Extra output tokens reserved for thinking (thinking counts against
# maxOutputTokens on Gemini 3.x; capped at 16384).
GEMINI_THINKING_HEADROOM_TOKENS=2048
# Optional explicit cross-provider fallback (never used unless listed here).
AI_FALLBACK_PROVIDERS=
# Bounds (defaults shown). Exceeding any bound stops the loop with a recorded stop_reason.
REV_AGENT_MAX_TOOL_CALLS=8
REV_AGENT_MAX_ITERATIONS=6
REV_AGENT_MAX_OUTPUT_TOKENS=1400
REV_AGENT_MAX_TOTAL_TOKENS=90000
REV_AGENT_MAX_COST_USD=0.50
REV_AGENT_MAX_SECONDS=75
REV_AGENT_TURN_TIMEOUT_SECONDS=35
REV_AGENT_TOOL_TIMEOUT_SECONDS=12
# Public web research inside store investigations (on|off).
REV_AGENT_WEB=on
# Live Shopify documentation search, restricted to shopify.dev, help.shopify.com
# and changelog.shopify.com (on|off). Needs a search-capable provider; no Shopify
# corpus is ingested, so with it off (or no provider) Shopify docs are reported
# as unavailable rather than claimed.
REV_SHOPIFY_DOCS_LIVE=on
# Execution telemetry is always on and content-free: one structured
# `rev_execution_record` log line per execution (ids, routing, provider/model,
# timings, provider-reported tokens, tools, retries, fallback, failure category,
# cancellation, final status). No messages, prompts, evidence values or PII.
